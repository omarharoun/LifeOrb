# LifeOrb Environment Variables
# Copy this file to .env.local and update with your values

# Application
NEXT_PUBLIC_APP_NAME="LifeOrb"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Features Flags
NEXT_PUBLIC_ENABLE_AI_SIMULATION="true"
NEXT_PUBLIC_ENABLE_SOCIAL_FEATURES="true"
NEXT_PUBLIC_ENABLE_ANALYTICS="false"

# Third-party Services (for future use)
# OPENAI_API_KEY=""
# DATABASE_URL=""
# REDIS_URL=""
